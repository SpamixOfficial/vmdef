{
    // the default register would be usize in size, no special properties, etc.
    // at least one RIP/PC-like register must be registered
    "registers": {
        "a": null,
        "b": null,
        "c": null,
        "d": null,
        "sp": {
            "attribute": "sp",
        },
        "pc": {
            "attribute": "pc",
        },
        "flags": {
            "attribute": "flags",
        },
    },
    "memory_size": null, // default is unlimited, grows as program runs, should either be a number or empty object
    /*"memory_layout": { // this is not needed for the reactor_vm
        // if your VM does not have a memory layout you can just leave this unspecified, just remember that it aids in disassembly interpretation
        "data": "0x0..0x1000", // specify as range (separated by ..), will be interpreted by rust
        "memory": "0x1000..",
    },*/
    "instruction": {
        "op_size": 8, // in bits, null means variable and a custom decoder will be necessary
    },
    "little_endian": true // doesn't really matter in our case since every piece of data is one byte
}
