{
    // the default register would be usize in size, no special properties, etc.
    // at least one RIP/PC-like register must be registered
    "registers": {
        "a": 0,
        "b": 1,
        "c": 2,
        "d": 3,
        "sp": {
            "code": 4,
            "attribute": "sp"
        },
        "pc": { // if a register, like pc and flags, does not have a designated code you can just leave it out.
            "attribute": "pc",
            "write": false
        },
        "flags": {
            "attribute": "flags"
        }
    },
    "memory": {
        "size": null, // default is unlimited, grows as program runs, should either be a number or empty object
        "initial_size": 0,
        "layout": { // this is not needed for the reactor_vm
            // if your VM does not have a memory layout you can just leave this unspecified, just remember that it aids in disassembly interpretation
            // specify as range (separated by ..), will be interpreted by rust
            /*"0x0..0x1000": {
                "name": "data",
                "permissions": "r"
            }, 
            "0x1000..":  {
                "name": "memory",
                "permissions": "rw"
            }*/
        }
    },
    "instruction": {
        "op_size": 2 // in bytes, null means variable and a custom decoder will be necessary (upcoming features)
    },
    "little_endian": true, // doesn't really matter in our case since every piece of data is one byte
    "implementation": "machine.py", // this can be overwritten in machine.init, at least one should be present!
    "verbose": true // this controls Err(e) log output, also configurable through machine.init
}
